    "head": "",
    "format": "<template>\n  <div class=\"painel\" :class=\"msg?.payload?.nivel || 'aguardando'\">\n    <div class=\"led\"></div>\n    <div>\n      <div class=\"titulo\">{{ msg?.payload?.titulo || 'Aguardando dados do ESP32...' }}</div>\n      <div class=\"detalhe\">{{ msg?.payload?.detalhe }}</div>\n      <div class=\"info\">{{ msg?.payload?.info }}</div>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n.painel { display: flex; align-items: center; gap: 20px; padding: 16px 20px; border-radius: 8px; background: #f1f3f5; width: 100%; }\n.painel.normal { background: #e8f5e9; }\n.painel.critico { background: #ffebee; }\n.led { width: 36px; height: 36px; border-radius: 50%; background: #9e9e9e; flex-shrink: 0; }\n.normal .led { background: #2e7d32; box-shadow: 0 0 14px #2e7d32; }\n.critico .led { background: #d32f2f; box-shadow: 0 0 18px #d32f2f; animation: pisca 1s infinite; }\n.titulo { font-size: 1.3rem; font-weight: 700; }\n.critico .titulo { color: #b71c1c; }\n.normal .titulo { color: #1b5e20; }\n.detalhe { font-size: 1.05rem; margin-top: 2px; }\n.info { font-size: 0.85rem; color: #666; margin-top: 4px; }\n@keyframes pisca { 50% { opacity: 0.35; } }\n</style>",
